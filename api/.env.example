# ─── API environment (backend) ───────────────────────────────────────────────
# Copy to .env (local) and set the same variables in the API host (Render/Railway).

# Runtime
NODE_ENV=production            # MUST be "production" on the deployed host:
                               # it switches the refresh-token cookie to
                               # SameSite=None; Secure so the session survives
                               # across the front (Vercel) and API (Render) domains.
PORT=3000
TRUST_PROXY_HOPS=1             # Number of reverse proxies in front of the API.
                               # 1 = single proxy (Render/Railway). Set to 2 if
                               # also behind Cloudflare/ALB so rate limiters
                               # resolve the real client IP.

# CORS / cross-domain — set BOTH to the exact front-end origin (no trailing slash),
# e.g. https://lei-pint-xxxx.vercel.app . These are the only origins allowed.
APP_URL=https://your-frontend.vercel.app
WEB_APP_URL=https://your-frontend.vercel.app

# Frontend deep links used in emails
FRONTEND_URL=https://your-frontend.vercel.app
FRONTEND_EMAIL_CONFIRMATION_URL=https://your-frontend.vercel.app/confirm-email
FRONTEND_RESET_PASSWORD_URL=https://your-frontend.vercel.app/reset-password

# Database (Neon PostgreSQL)
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=5432

# Auth
JWT_SECRET_KEY=
JWT_EXPIRES_IN=15m

# Redis (Upstash)
REDIS_URL=

# Supabase storage
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_API_KEY=

# Email (SMTP)
EMAIL_USER=
EMAIL_PASSWORD=

# Branding / certificates
LOGO_URL=
CERTIFICATE_ISSUING_ENTITY=Softinsa

# Logging
LOGGING_ENABLED=true
LOG_LEVEL=info

# Toggles (leave unset/0 in production)
# SKIP_FIREBASE=0
# SKIP_API_ROUTES=0
# DEV_PUBLIC_URL=
