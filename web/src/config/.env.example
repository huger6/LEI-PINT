# ─── Web environment (frontend) ──────────────────────────────────────────────
# Vite loads env from this folder (web/src/config). Copy to .env here, and set
# the same variables in Vercel (Project Settings → Environment Variables).

# Base URL of the deployed API (NO trailing slash). The app calls `${API_URL}/api`.
# In production this MUST point to the API host (e.g. https://your-api.onrender.com).
# Locally it can be http://localhost:3000 (the Vite dev proxy uses it too).
API_URL=https://your-api.onrender.com

# Supabase storage (public reads / direct uploads from the browser)
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_API_KEY=
VITE_SUPABASE_STORAGE_URL=
VITE_SUPABASE_STORAGE_API_KEY=
