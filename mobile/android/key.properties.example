# Release signing configuration for the Android app.
#
# 1. Generate an upload keystore (run once, keep the .jks safe and private):
#      keytool -genkey -v -keystore upload-keystore.jks \
#        -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# 2. Copy this file to `android/key.properties` and fill in the values below.
#    `android/key.properties` and *.jks/*.keystore are gitignored — never commit them.
#
# 3. Build:  flutter build apk --release   (or)   flutter build appbundle --release
#
# If `android/key.properties` is absent, the release build falls back to the
# debug keys (fine for local testing, NOT for distribution).

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
# Path to the keystore file. Relative paths are resolved from `android/app/`.
# Easiest: place the .jks in android/app/ and use just the file name, or use an
# absolute path. e.g. storeFile=upload-keystore.jks  or  C:/keys/upload-keystore.jks
storeFile=upload-keystore.jks
